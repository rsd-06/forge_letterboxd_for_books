# Bookboxd Configuration
DJANGO_SECRET_KEY=django-insecure-z8ml0(02yvunmv=rwh=abg3)z6$j8)&063g!o(h#$e^7ckzg=!
DJANGO_DEBUG=True

# Google Gemini API Key (Free tier from https://aistudio.google.com/)
# 1. Go to https://aistudio.google.com/
# 2. Click "Get API key" -> "Create API key in new project"
# 3. Paste the key below:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# MongoDB Atlas URI (Free tier from https://www.mongodb.com/cloud/atlas)
# 1. Create a free M0 cluster on MongoDB Atlas
# 2. In "Database Access", create a database user and password
# 3. In "Network Access", add 0.0.0.0/0 (or your IP)
# 4. Click "Connect" -> "Drivers" -> "Python" -> copy connection string
# e.g.: mongodb+srv://username:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_NAME=bookboxd
